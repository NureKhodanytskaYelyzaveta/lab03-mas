digraph G {
  rankdir=TB; nodesep=0.3; ranksep=0.3;
  node [fontname="Liberation Serif", fontsize=12, shape=box, style="rounded,filled", margin="0.12,0.05"];
  edge [fontname="Liberation Serif", fontsize=11];
  START [shape=circle, fillcolor="#ffffff", width=0.7, fixedsize=true];
  intake [shape=box, style="filled", fillcolor="#e7e6e6", label="intake\n(функція)"];
  reject [shape=box, style="filled", fillcolor="#e7e6e6", label="reject\n(функція)"];
  researcher [fillcolor="#e2f0d9", label="researcher\n(LLM + search_knowledge)\nкрок 13"];
  scene_designer [fillcolor="#d9e2f3", label="scene_designer\n(LLM)"];
  scene_check [shape=box, style="filled", fillcolor="#e7e6e6", label="scene_check"];
  audio_designer [fillcolor="#d9e2f3", label="audio_designer\n(LLM)"];
  visual_designer [fillcolor="#d9e2f3", label="visual_designer\n(LLM)"];
  plans [shape=box, style="filled", fillcolor="#fff2cc", label="plans\n(JoinNode)"];
  link_check [shape=box, style="filled", fillcolor="#e7e6e6", label="link_check"];
  director [fillcolor="#d9e2f3", label="director\n(LLM)"];
  gate [shape=box, style="filled", fillcolor="#e7e6e6", label="gate"];
  risk_check [shape=box, style="filled", fillcolor="#fce4d6", label="risk_check\nкрок 14"];
  human_review [shape=box, style="filled", fillcolor="#fce4d6", label="human_review\n(запит людині)"];
  human_decision [shape=box, style="filled", fillcolor="#fce4d6", label="human_decision"];
  publish [shape=box, style="filled", fillcolor="#e7e6e6", label="publish"];
  START -> intake;
  intake -> reject [label="reject"];
  intake -> researcher [label="ok"];
  researcher -> scene_designer;
  scene_designer -> scene_check;
  scene_check -> scene_designer [label="fix", constraint=false];
  scene_check -> audio_designer [label="ok"];
  scene_check -> visual_designer [label="ok"];
  audio_designer -> plans;
  visual_designer -> plans;
  plans -> link_check;
  link_check -> scene_designer [label="fix", constraint=false];
  link_check -> director [label="ok"];
  director -> gate;
  gate -> scene_designer [label="revise", constraint=false];
  gate -> risk_check [label="publish"];
  risk_check -> publish [label="safe"];
  risk_check -> human_review [label="risky"];
  human_review -> human_decision;
  human_decision -> publish [label="approved / rejected"];
  human_decision -> scene_designer [label="revise\n(≤ MAX_DRAFTS)", constraint=false];
}
